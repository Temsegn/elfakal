PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/elfakal
# Comma-separated allowed frontend origins (required on Render)
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Default admin (seeded on startup / db:seed)
ADMIN_EMAIL=admin@elfakal.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin
